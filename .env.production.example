# ==============================================================================
# VYNK SOCIAL PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting containers:
#   cp .env.production.example .env
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server & Client Networking
PORT=5000
CLIENT_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com,http://localhost,http://127.0.0.1

# Security & Authentication (REQUIRED: Generate a secure 64-char hex string)
# e.g., run: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_64_CHAR_HEX_STRING_FOR_PRODUCTION
JWT_EXPIRES_IN=7d

# Database Configuration (Persistent Container Volume)
DB_PATH=/app/backend/data/vynk.db

# Media Storage Provider
# Options: 'local' | 's3' | 'cloudinary' (defaults to persistent container volume)
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/backend/uploads

# AI Provider Configuration
# Options: 'gemini' | 'openai' | 'ollama' | 'local_semantic'
# If cloud keys are left empty, Vynk automatically defaults to 'local_semantic' (vynk-semantic-nlp-v4)
AI_PROVIDER=local_semantic
AI_MODEL=vynk-semantic-nlp-v4

# Optional: Google Gemini API Configuration
GEMINI_API_KEY=

# Optional: OpenAI or Groq/OpenRouter Compatible API Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Ollama Local Server
OLLAMA_BASE_URL=http://host.docker.internal:11434
