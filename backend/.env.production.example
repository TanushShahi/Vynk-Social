# Backend Production Environment Variables
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost
CORS_ORIGIN=http://localhost,http://localhost:80,http://127.0.0.1
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_64_CHAR_HEX_STRING_FOR_PRODUCTION
JWT_EXPIRES_IN=7d
DB_PATH=/app/backend/data/vynk.db
UPLOAD_DIR=/app/backend/uploads
STORAGE_PROVIDER=local
AI_PROVIDER=local_semantic
AI_MODEL=vynk-semantic-nlp-v4
GEMINI_API_KEY=
OPENAI_API_KEY=
