# ==============================================================================
# Vynk Social — Root Git Ignore
# ==============================================================================

# 1. Dependencies & Package Managers
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# 2. Build Outputs & Compilations
dist/
**/dist/
build/
**/build/
.output/
*.tsbuildinfo

# 3. Environment & Secret Configuration Files
.env
.env.*
!.env.example
!.env.production.example
!production_environment.example
!backend/.env.production.example
!frontend/.env.production.example
*.pem
*.key
*.cert
*.crt

# 4. SQLite Database & Storage Engine Files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
**/data/*.db*
backend/data/*.db*
!**/data/.gitkeep
!backend/data/.gitkeep

# 5. User Uploaded Private Media & Content
uploads/*
**/uploads/*
!uploads/.gitkeep
!**/uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# 6. Logs & Debugging Output
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. IDE, Editor & Operating System Caches
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
.eslintcache
.stylelintcache
