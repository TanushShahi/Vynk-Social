# ===================================================
# VYNK SOCIAL PLATFORM - ENVIRONMENT CONFIGURATION
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=your_dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration
# Local default: SQLite (Zero config, no server setup needed)
DB_PATH=./data/vynk.db
# Production upgrade: Supabase / Neon PostgreSQL connection string
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Media Storage Provider
# Local default: 'local' (Files served from /uploads)
STORAGE_PROVIDER=local
# Production upgrade: 'supabase' or 'cloudinary'
# SUPABASE_URL=https://[YOUR_PROJECT].supabase.co
# SUPABASE_ANON_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# AI Provider Configuration
# Free/Default: 'local' (Fast local NLP, heuristic caption generator & moderation)
AI_PROVIDER=local
# Production upgrade: 'open_source' (HuggingFace free-tier) or 'external' (Gemini, Claude, OpenAI)
# AI_API_KEY=
